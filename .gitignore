# Files the program writes while it runs, and Python caches.
__pycache__/
*.pyc

# The raw vendor answers and the journal of the program. They carry the
# addresses, the keys and the camouflage names of the account, so they never
# belong in the repository.
logs/

# Local editors and the tools that run inside them.
*.swp
.idea/
.vscode/
.sentry-native/
