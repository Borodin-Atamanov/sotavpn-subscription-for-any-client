#!/usr/bin/env python3
"""Raise the patch number of PROGRAM_VERSION in settings.py before every commit.

git runs this file on every commit of a clone that turns it on once with
`git config core.hooksPath hooks`. The number lives in the settings file
as one literal line, and this hook is its only writer: it reads the line,
raises the third number by one, writes the file back and stages it, so
the commit itself carries the new number.

The hook works with best effort: any failure prints a warning to stderr
and the hook still exits 0, so a broken bump never blocks a commit.
"""

import re
import subprocess
import sys
from pathlib import Path

VERSION_PATTERN = re.compile(r'PROGRAM_VERSION = "([^"]+)"')
SETTINGS_FILE_NAME = "settings.py"


def get_version_numbers(version):
    """The three numbers of a dotted version; ValueError on any other shape."""
    parts = version.split(".")
    if len(parts) != 3 or not all(part.isdigit() for part in parts):
        raise ValueError(f"invalid version: {version}")
    major, minor, patch = (int(part) for part in parts)
    return major, minor, patch


def get_next_version(version):
    """The next patch version of a dotted triple; ValueError on any other shape."""
    major, minor, patch = get_version_numbers(version)
    return f"{major}.{minor}.{patch + 1}"


def bump_settings_version(settings_file):
    """Raise the version line of one settings file and answer the new number."""
    text = settings_file.read_text(encoding="utf-8")
    found = VERSION_PATTERN.search(text)
    if found is None:
        raise ValueError(f"no version line in {settings_file}")
    new_version = get_next_version(found.group(1))
    replaced = VERSION_PATTERN.sub(f'PROGRAM_VERSION = "{new_version}"', text, count=1)
    settings_file.write_text(replaced, encoding="utf-8")
    return new_version


def get_repository_root():
    """The root of the repository git is committing in, or an empty answer."""
    finished = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False
    )
    return finished.stdout.strip() if finished.returncode == 0 else ""


def main():
    """Bump the version and stage it; warn and answer 0 on any failure."""
    root = get_repository_root()
    if not root:
        print("sotavpn pre-commit: not a git repository, skipping the version bump", file=sys.stderr)
        return 0
    settings_file = Path(root) / SETTINGS_FILE_NAME
    try:
        new_version = bump_settings_version(settings_file)
    except (OSError, ValueError) as error:
        print(f"sotavpn pre-commit: the version bump failed, committing without it: {error}", file=sys.stderr)
        return 0
    staged = subprocess.run(
        ["git", "add", str(settings_file)], capture_output=True, text=True, check=False
    )
    if staged.returncode != 0:
        print(
            f"sotavpn pre-commit: version {new_version} is in the file but could not be staged, "
            "committing without it",
            file=sys.stderr,
        )
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
